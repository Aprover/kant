// esempio di scambio di chiavi simmetriche
principal Alice, Bob

Alice know {
    state a1;
    const priv_key_a: PrivateKey; 
    pub_key_a = PUB_GEN(priv_key_a);
}

Alice -> Bob : pub_key_a

Bob know {
    state b1;
    fresh priv_key_b: PrivateKey;
    pub_key_b = PUB_GEN(priv_key_b);
}

Bob -> Alice : pub_key_b

Alice know {
    state a2;
    fresh key_ab: SymmetricKey;
    encrypted_key_ab = PKE_ENC(key_ab) with pub_key_b;
}

Alice -> Bob : encrypted_key_ab

Bob know {
    state b2;
    fresh message: BitString;
    dec_key_ab = PKE_DEC(encrypted_key_ab) with priv_key_b;
    encrypted_message = ENC(message) with dec_key_ab;

}

Bob -> Alice  : encrypted_message

Alice know { 
    state a3;   
    decrypted_message = DEC(encrypted_message) with key_ab;
}