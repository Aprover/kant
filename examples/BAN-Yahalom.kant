//A->B:A,na
//B->S:B,nb,{A,na}kbs
//S->A:nb,{B,kab,na}kas,{A,kab,nb}kbs
//A->B:{A,kab,nb}kbs,{nb}kab

principal Alice,Bob,Server

Alice, Server share{
    const kas:SymmetricKey;
}

Bob, Server share{
    const kbs:SymmetricKey;
}

Alice know{ 
    state a1;
    fresh na: Nonce;
    const a_cert:IdCertificate;
    m1=CONCAT(a_cert,na);
}

Alice -> Bob: m1

Bob know{
    state b1;
    fresh nb: Nonce;
    const b_cert:IdCertificate;
    enc_a_na=ENC <aes_128_cbc> (m1) with kbs;
    m2=CONCAT(b_cert,nb,enc_a_na);
}

Bob -> Server: m2

Server know{
    state s1;
    fresh kab: SymmetricKey;
    split_m2=SPLIT(m2);
    dec_a_na=DEC(split_m2[2]) with kbs;
    split_dec_a_na=SPLIT(dec_a_na);
    m3_1=CONCAT(split_m2[0],kab,split_dec_a_na[1]);
    enc_m3_1=ENC(m3_1) with kas;
    m3_2=CONCAT(split_dec_a_na[0],kab,split_m2[1]);
    enc_m3_2=ENC(m3_2) with kbs;
    m3=CONCAT(split_m2[1],enc_m3_1,enc_m3_2);
}

Server -> Alice: m3

Alice know{
    state a2;
    transition a1 => a2;
    split_m3=SPLIT(m3);
    dec_m3_1=DEC(split_m3[1]) with kas;
    split_b_kab_na=SPLIT(dec_m3_1);
    m4_1=ENC(split_b_kab_na[2]) with split_b_kab_na[1];
    m4=CONCAT(split_m3[2],m4_1);
} 

Alice->Bob: m4

Bob know{
    state b2;
    transition b1 => b2;
    split_m4=SPLIT(m4);
    dec_m4_0=DEC(split_m4[0]) with kbs;
    split_a_kab_nb=SPLIT(dec_m4_0);
    dec_m4_1=DEC(split_m4[1]) with split_a_kab_nb[1];
}